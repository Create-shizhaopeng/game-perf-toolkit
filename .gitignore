# PyInstaller / 编译产物
source/dist/
source/build/
dist/
build/
*.spec
*.spec.bak

# 虚拟环境
source/.venv/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# 运行时本地数据（不提交）
source/data/backups/
source/data/config.json

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/settings.local.json
.claude/skills/speckit.*
# .specify 目录 — 保留 constitution.md，其他忽略
.specify/*
!.specify/memory/
!.specify/memory/constitution.md
.playwright-mcp/


# Cursor — 忽略个人配置但保留项目共享内容
.cursor/*
!.cursor/skills/
.cursor/skills/spec*
!.cursor/rules/
!.cursor/commands/

# Cluade code保留项目共享内容，删掉个人本地的工具，配置等
.claude/*
!.claude/skills/
.claude/skills/spec*
.claude/skills/openspec*
!.claude/rules/

**/.github/
**/.specify/

# 运行时数据
data/

# 日志与临时文件
*.log
*.tmp
*.temp
*.swp

# 本地提交说明草稿（勿提交，避免污染历史）
commit_msg*.txt
*_commit_msg.txt
lv-game-toolkit-commit.txt

# 根目录误放的 zip 产物
/*.zip

# PyInstaller 本地分析报告（若生成在仓库路径内）
warn-build.txt
xref-*.html

# 规格目录下由工具生成的任务截图（时间戳 png，一般不纳入版本库）
**/specs/**/image/tasks/

# 本地 UI 示意图与配套说明（不推远程，协作者按需自备）
UI示意图/
/UI.jpg
/ui.png
/ui2.png
/ui3.png
/model名修改重置工具.md
**/modules/perfetto_analysis/skills/smart-perfetto/

# 架构设计文档已迁移至 doc/architecture/（纳入 Git 管理）

# MCP 服务器运行时工作目录
.playwright-mcp/

# 归档的源代码仓库（含嵌套 .git，不纳入主仓管理）
_archived_source/

# 构建脚本生成的临时版本文件
/VERSION

# 测试数据（大型二进制文件，不纳入版本库）
*.perfetto-trace
modules/perfetto_analysis/tests/2026-*/

# 性能配置模块（内部模块，不上传 GitHub 仓库，发布产物也不含）
modules/game_perf/
