{
  "atrace_categories": [
    "sched",
    "freq",
    "am",
    "wm",
    "gfx",
    "view",
    "input"
  ],
  "duration_sec": 15,
  "buffer_manual_override": false,
  "buffer_safety_factor": 1.05,
  "device_trace_dir": "/data/misc/perfetto-traces",
  "output_dir": "output",
  "flush_period_ms": 5000,
  "clear_period_ms": 15000,
  "metadata_buffer_size_kb": 4096,
  "proc_stats_poll_ms": 1000,
  "file_write_period_ms": 2500,
  "compact_sched_enabled": true,
  "scan_all_processes_on_start": true,
  "record_thread_names": true,
  "atrace_apps_global": ["*"],
  "_data_sources_notes": "推荐可选: android.polling_state(需Android13+), android.input.inputevent",
  "data_sources": [
    { "name": "android.surfaceflinger.frametimeline" }
  ],
  "target": {
    "mode": "global",
    "packages": []
  },
  "advanced": {
    "available_ftrace_events": [
      "sched/sched_switch",
      "sched/sched_wakeup",
      "power/cpu_frequency",
      "power/cpu_idle",
      "power/suspend_resume",
      "irq/irq_handler_entry",
      "irq/irq_handler_exit",
      "irq/softirq_entry",
      "irq/softirq_exit",
      "block/block_rq_issue",
      "block/block_rq_complete",
      "filemap/mm_filemap_add_to_page_cache",
      "vmscan/mm_vmscan_direct_reclaim_begin",
      "gpu_mem/gpu_mem_total",
      "mali/mali_PM_MCU_HCTL_CORES_NOTIFY_PEND",
      "thermal/thermal_temperature"
    ],
    "ftrace_events": [],
    "sampling": {},
    "enable_raw_perfetto_config": false,
    "raw_perfetto_config_text": ""
  },
  "export": {
    "cleanup_device_files": false
  },
  "logging": {
    "debug": false
  },
  "history": {
    "max_history_days": 30,
    "max_history_count": 50,
    "auto_cleanup_on_start": true
  },
  "jank": {
    "enabled": false,
    "target_package": "",
    "jank_threshold": 3,
    "max_captures": 3,
    "stabilize_delay_sec": 2,
    "max_stabilize_sec": 8,
    "max_duration_hours": 3
  }
}