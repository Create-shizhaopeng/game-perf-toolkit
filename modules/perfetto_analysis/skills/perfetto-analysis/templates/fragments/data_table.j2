<div class="data-section">
  <h3>{{ section_title }}</h3>
  {% if section_note %}<p class="section-note">{{ section_note }}</p>{% endif %}
  <table class="data-table">
    <thead>
      <tr>
      {% for col in columns %}
        <th>{{ col.label | default(col) }}</th>
      {% endfor %}
      </tr>
    </thead>
    <tbody>
    {% for row in rows %}
      <tr>
      {% for col in columns %}
        {% set key = col.key if col is mapping else col %}
        <td class="col-{{ col.format | default('text') }}">{{ row[key] if row is mapping else row[loop.index0] }}</td>
      {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if show_distribution_bar %}
  <div class="distribution-bar">
    {% for row in rows %}
    {% set pct = row.percentage if row is mapping else row[2] %}
    {% set label = row.range if (row is mapping and row.range) else (row[0] if not row is mapping else row[columns[0].key]) %}
    <div class="bar-segment" style="flex: {{ pct | default(0) }}">
      <span class="bar-label">{{ label }}</span>
      <span class="bar-value">{{ pct }}%</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
